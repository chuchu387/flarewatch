#!/usr/bin/env bash

set -uo pipefail

OPS_DIR="${CODASTRA_OPS_DIR:-/opt/codastra-ops}"
INVENTORY="$OPS_DIR/inventory.json"
PM2_HOME="/home/codastra/.pm2"

if [[ ! -r "$INVENTORY" ]]; then
  echo "Inventory is not readable: $INVENTORY" >&2
  exit 2
fi

printf 'CodAstra Hostinger status - %s\n' "$(date --iso-8601=seconds)"
printf 'Host: %s | Uptime: %s\n\n' "$(hostname)" "$(uptime -p)"
printf '%-14s %-8s %-5s %-9s %-22s %-12s %-8s\n' \
  'APPLICATION' 'MANAGER' 'PORT' 'PROCESS' 'LISTENER' 'PUBLIC API' 'RESULT'
printf '%-14s %-8s %-5s %-9s %-22s %-12s %-8s\n' \
  '--------------' '--------' '-----' '---------' '----------------------' '------------' '--------'

overall=0

while IFS=$'\t' read -r name manager process port health_url; do
  process_state='offline'
  if [[ "$manager" == 'systemd' ]]; then
    process_state="$(systemctl is-active "$process" 2>/dev/null || true)"
  elif PM2_HOME="$PM2_HOME" pm2 describe "$process" 2>/dev/null | grep -Eq 'status[[:space:]]+.*online'; then
    process_state='online'
  fi

  listener="$(ss -lntH 2>/dev/null | awk -v suffix=":$port" '$4 ~ (suffix "$") { print $4; exit }')"
  [[ -n "$listener" ]] || listener='missing'

  listener_ok=false
  if [[ "$listener" == "127.0.0.1:$port" || "$listener" == "[::1]:$port" ]]; then
    listener_ok=true
  fi

  curl_result="$(curl --silent --show-error --output /dev/null \
    --connect-timeout 5 --max-time 10 --write-out '%{http_code} %{time_total}' \
    "$health_url" 2>/dev/null || printf '000 0')"
  http_code="${curl_result%% *}"
  elapsed="${curl_result#* }"
  public_state="HTTP $http_code"
  if [[ "$http_code" =~ ^[23][0-9][0-9]$ ]]; then
    public_state="$http_code/${elapsed}s"
  fi

  result='OK'
  if [[ ! "$process_state" =~ ^(active|online)$ ]] || [[ "$listener_ok" != true ]] || [[ ! "$http_code" =~ ^[23][0-9][0-9]$ ]]; then
    result='CHECK'
    overall=1
  fi

  printf '%-14s %-8s %-5s %-9s %-22s %-12s %-8s\n' \
    "$name" "$manager" "$port" "$process_state" "$listener" "$public_state" "$result"
done < <(node -e '
  const inventory = require(process.argv[1]);
  for (const app of inventory.applications) {
    console.log([app.name, app.manager, app.process, app.port, app.healthUrl].join("\t"));
  }
' "$INVENTORY")

printf '\nResources\n'
free -h | awk 'NR == 2 { printf "Memory: %s used / %s total, %s available\n", $3, $2, $7 } NR == 3 { printf "Swap:   %s used / %s total\n", $3, $2 }'
df -h / | awk 'NR == 2 { printf "Disk:   %s used / %s total (%s), %s available\n", $3, $2, $5, $4 }'
printf 'Load:   %s\n' "$(cut -d ' ' -f 1-3 /proc/loadavg)"

printf '\nInfrastructure\n'
for unit in nginx pm2-codastra fail2ban certbot.timer codastra-monitor.timer flarewatch-proxy codastra-telemetry; do
  state="$(systemctl is-active "$unit" 2>/dev/null || true)"
  [[ "$state" == 'active' ]] || overall=1
  printf '%-26s %s\n' "$unit" "$state"
done

status_page_result="$(curl --silent --show-error --output /dev/null \
  --connect-timeout 5 --max-time 10 --write-out '%{http_code} %{time_total}' \
  'https://status.codastralabs.com/api/data' 2>/dev/null || printf '000 0')"
status_page_code="${status_page_result%% *}"
if [[ ! "$status_page_code" =~ ^[23][0-9][0-9]$ ]]; then
  overall=1
fi
printf '%-26s %s\n' 'External status page' "${status_page_code}/${status_page_result#* }s"

if [[ "$overall" -eq 0 ]]; then
  printf '\nOverall: HEALTHY\n'
else
  printf '\nOverall: CHECK REQUIRED\n'
fi

exit "$overall"
