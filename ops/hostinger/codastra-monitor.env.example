# Alert delivery
MONITOR_ALERT_TO=alerts@example.com
MONITOR_CPU_WARN_PERCENT=90
MONITOR_MEMORY_WARN_PERCENT=85
MONITOR_SWAP_WARN_PERCENT=60
MONITOR_DISK_WARN_PERCENT=80
MONITOR_SSL_WARN_DAYS=21

# FlareWatch heartbeat URL including the secret monitor path
FLAREWATCH_HEARTBEAT_URL=https://status.example.com/api/heartbeat/REPLACE_ME

# Dependency credentials loaded from the production application environment
MONGO_URI=
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=CodAstra Server Monitor
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
